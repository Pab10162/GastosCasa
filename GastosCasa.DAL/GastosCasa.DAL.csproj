<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GastosCasa.BE\GastosCasa.BE.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Driver ADO.NET oficial de Microsoft para SQLite -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- El script se copia junto al .exe para que InicializadorBD lo encuentre -->
    <None Include="BD\schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
